{
  "name": "dayu",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "ci:links": "node scripts/check-links.mjs",
    "ci:licenses": "node scripts/check-licenses.mjs",
    "ci:secrets": "node scripts/check-secrets.mjs",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "demo": "node scripts/local-demo.mjs",
    "demo:smoke": "node scripts/local-demo.mjs --smoke",
    "e2e": "playwright test",
    "release:gate": "pnpm --filter @dayu/calibration evaluate"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.68.0",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.11"
  }
}
