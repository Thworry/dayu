{
  "name": "dayu",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "ci:licenses": "node scripts/check-licenses.mjs",
    "ci:secrets": "node scripts/check-secrets.mjs",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.34.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.34.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.4"
  }
}
